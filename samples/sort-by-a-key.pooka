module main

import pooka/int
import pooka/io
import pooka/list
import pooka/order
import pooka/string

class Book(title: String, author: String, year: Int)

show(books: List(Book)) -> Nil {
  list.each(books, fn(book: Book) {
    io.println(int.to_string(book.year) + "  " + book.title)
    Nil
  })
}

main() {
  let shelf = [
    Book("The Hobbit", "Tolkien", 1937),
    Book("Moominsummer Madness", "Jansson", 1954),
    Book("A Wizard of Earthsea", "Le Guin", 1968),
    Book("Comet in Moominland", "Jansson", 1946)
  ]

  io.println("Oldest first:")
  show(
    list.sort_by(shelf, fn(a: Book, b: Book) { int.compare(a.year, b.year) })
  )

  io.println("\nNewest first:")
  show(list.sort_by(shelf, fn(a: Book, b: Book) {
    order.reverse(int.compare(a.year, b.year))
  }))

  io.println("\nBy author, then title:")
  show(list.sort_by(shelf, fn(a: Book, b: Book) {
    match string.compare(a.author, b.author) {
      order.Order.Equal -> string.compare(a.title, b.title)
      other -> other
    }
  }))
}

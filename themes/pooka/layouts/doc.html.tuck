{% extends "base.html.tuck" %}
{% block body %}

<div class="wrap docs-layout">
{% include "partials/docs-nav.html.tuck" %}
<article class="doc">
  <p class="doc-group">{{ group }}</p>
  <h1>{{ title }}</h1>
  <div class="prose">
{{ content | safe }}
  </div>
  <nav class="pager" aria-label="More guides">
    {%- if page.previous %}<a href="{{ page.previous.url }}"><small>Previous</small><strong>← {{ page.previous.navTitle | default(page.previous.title) }}</strong></a>{% endif %}
    {%- if page.next %}<a class="next" href="{{ page.next.url }}"><small>Next</small><strong>{{ page.next.navTitle | default(page.next.title) }} →</strong></a>{% endif %}
  </nav>
</article>
<aside class="toc" aria-label="On this page">
  <h4>On this page</h4>
  <ol>
    {%- for heading in page.outline | where("level", 2) %}
    <li><a href="#{{ heading.id }}">{{ heading.text }}</a></li>
    {%- endfor %}
  </ol>
</aside>
</div>

{% endblock %}

<nav class="doc-nav" aria-label="Documentation">
  {%- for group_name in data.docs.groups %}
  <h4>{{ group_name }}</h4>
  <ul>
    {%- for entry in collections.guides | concat(data.docs.outside) | where("group", group_name) | sort_by("order") %}
    <li><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.navTitle | default(entry.title) }}</a></li>
    {%- endfor %}
  </ul>
  {%- endfor %}
</nav>

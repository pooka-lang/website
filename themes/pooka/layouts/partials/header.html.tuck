<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><img src="/assets/logos/logo-mark.svg" alt="" width="40" height="34">Pooka</a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="Menu"
    >☰</button>
    <nav class="nav" id="site-nav" aria-label="Main">
      {%- for item in site.params.nav %}
      <a href="{{ item.url }}"{% if page.url and (page.url | starts_with(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
      <a class="nav-github" href="{{ site.params.github }}">GitHub</a>
    </nav>
  </div>
</header>

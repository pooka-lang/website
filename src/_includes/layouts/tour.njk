---
layout: layouts/base.njk
---
<section class="page-head tour-head">
  <div class="wrap">
    <div>
      <span class="eyebrow">The tour</span>
      <h1>{{ heading or title }}</h1>
      <p>{{ lede }}</p>
    </div>
    <img class="mascot" src="/assets/mascots/mascot-hero-lantern.png" alt="" width="200">
  </div>
</section>
<div class="wrap tour-layout">
  <nav class="tour-nav" aria-label="Chapters">
    <h4>Chapters</h4>
    <ol>
      {%- for chapter in content | chapters %}
      <li><a href="#{{ chapter.id }}"><span class="n">{{ chapter.number }}</span>{{ chapter.title }}</a></li>
      {%- endfor %}
    </ol>
    <a class="tour-docs" href="/docs/">All documentation →</a>
  </nav>
  <article class="prose tour">
{{ content | chapterHeadings | safe }}
  </article>
</div>

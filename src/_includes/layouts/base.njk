<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set fullTitle = (title | stripTags) + " · Pooka" if title else "Pooka" %}
{%- set summaryText = (description or summary or site.description) | stripTags %}
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ summaryText }}">
<meta name="theme-color" content="#211C1B">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ fullTitle }}">
<meta property="og:description" content="{{ summaryText }}">
<meta property="og:image" content="{{ site.url }}/assets/mascots/mascot-hero-lantern.png">
<link rel="icon" href="/assets/logos/logo-mark.svg" type="image/svg+xml">
<link rel="icon" href="/assets/favicon.png" type="image/png" sizes="64x64">
<link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="Pooka news" href="/feed.xml">
<link rel="stylesheet" href="{{ '/css/style.css' | asset }}">
<script src="{{ '/js/site.js' | asset }}" defer></script>
{%- if site.analytics and eleventy.env.runMode == "build" %}
<script data-goatcounter="{{ site.analytics }}" async src="https://gc.zgo.at/count.js"></script>
{%- endif %}
{%- for script in scripts %}
<script src="{{ ('/js/' + script + '.js') | asset }}" {% if script == "packages" %}type="module"{% else %}defer{% endif %}></script>
{%- endfor %}
</head>
<body>
{% include "partials/header.njk" %}
<main id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
</body>
</html>

---
layout: layouts/base.njk
---
{%- set index = collections.posts | getCollectionItemIndex %}
{%- set older = collections.posts[index - 1] if index > 0 else null %}
{%- set newer = collections.posts[index + 1] %}
<header class="article-head">
  <div class="wrap">
    <div class="meta">
      <a href="/news/">← News</a>
      <span class="chip chip-{{ kind }}">{{ kinds[kind] }}</span>
      <time datetime="{{ page.date | isoDate }}">{{ page.date | longDate }}</time>
      {%- if readingTime %}<span>·</span><span>{{ readingTime }}</span>{% endif %}
    </div>
    <h1>{{ title }}</h1>
    <p class="lede">{{ summary | inlineCode | safe }}</p>
    <div class="byline">
      <img src="/assets/logos/logo-mark.svg" alt="">
      <div><strong>{{ author or "The Pooka team" }}</strong><br><span class="muted">{{ authorRole or kinds[kind] }}</span></div>
    </div>
  </div>
</header>
<div class="wrap article-layout">
  <article class="prose">
{{ content | safe }}
    <nav class="pager" aria-label="More news">
      {%- if newer %}<a href="{{ newer.url }}"><small>Newer</small><strong>← {{ newer.data.title }}</strong></a>{% endif %}
      {%- if older %}<a class="next" href="{{ older.url }}"><small>Older</small><strong>{{ older.data.title }} →</strong></a>{% endif %}
    </nav>
  </article>
  <aside class="toc" aria-label="On this page">
    {%- set headings = content | outline %}
    {%- if headings.length %}
    <h4>On this page</h4>
    <ol>
      {%- for heading in headings %}
      <li><a href="#{{ heading.id }}">{{ heading.text }}</a></li>
      {%- endfor %}
    </ol>
    {%- endif %}
    {%- if download %}<a class="btn btn-dark btn-small" href="{{ download.url }}">{{ download.label }}</a>{% endif %}
  </aside>
</div>

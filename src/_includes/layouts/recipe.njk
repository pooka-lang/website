---
layout: layouts/base.njk
---
{%- set shelfInfo = shelves[shelf] %}
<header class="article-head">
  <div class="wrap">
    <div class="meta">
      <a href="/cookbook/">← Cookbook</a>
      <span class="chip chip-library">{{ shelfInfo.title }}</span>
      <span>{{ level }}</span>
      <span>·</span>
      <span>Pooka {{ pookaVersion or site.version }}</span>
    </div>
    <h1>{{ title }}</h1>
    <p class="lede">{{ summary | inlineCode | safe }}</p>
  </div>
</header>
<div class="wrap article-layout">
  <article class="prose">
    {%- if ingredients %}
    <div class="ingredients">
      <h4>You will use</h4>
      <ul>
        {%- for item in ingredients %}
        <li>{{ item | inlineCode | safe }}</li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- if sample %}
    <h2 id="program">The whole program</h2>
    <div class="window">
      <div class="window-bar"><span class="dots"><span></span><span></span><span></span></span><span class="title">src/main.pooka</span></div>
      <pre><code class="language-pooka">{% sample sample %}</code></pre>
    </div>
    {%- endif %}
{{ content | safe }}
    <nav class="pager" aria-label="More recipes">
      <a href="/cookbook/#{{ shelf }}"><small>Back to</small><strong>← {{ shelfInfo.title }}</strong></a>
    </nav>
  </article>
  <aside class="toc" aria-label="On this page">
    <h4>On this page</h4>
    <ol>
      {%- if sample %}<li><a href="#program">The whole program</a></li>{% endif %}
      {%- for heading in content | outline %}
      <li><a href="#{{ heading.id }}">{{ heading.text }}</a></li>
      {%- endfor %}
    </ol>
  </aside>
</div>

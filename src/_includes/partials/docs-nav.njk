<nav class="doc-nav" aria-label="Documentation">
  {%- for group in collections.guides | docsMenu(docs) %}
  <h4>{{ group.name }}</h4>
  <ul>
    {%- for entry in group.entries %}
    <li><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
    {%- endfor %}
  </ul>
  {%- endfor %}
</nav>
